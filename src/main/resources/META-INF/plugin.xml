<idea-plugin>
    <id>com.audioexplainer.rider</id>
    <name>Explain Code Audio</name>
    <vendor>Andrej Zigmund</vendor>

    <description><![CDATA[
        Right-click <b>"Explain This (Audio)"</b> to get a spoken, line-highlighted walkthrough of the
        selected code — or the method/class under the cursor. Uses Claude Code (headless) as the
        reasoning backbone and a local Kokoro TTS server for narration.
        <br/><br/>
        Requires the Claude CLI on PATH and a local TTS server (see the plugin's setup docs).
    ]]></description>

    <!-- Depending only on the platform module makes this a pure frontend plugin,
         loadable in Rider and every other IntelliJ-based IDE. -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Rider replaces the IntelliJ Project view with its own Solution Explorer, whose context menu is
         populated from SolutionExplorerPopupMenu (NOT ProjectViewPopupMenu). Loading this extra descriptor
         only when the Rider module is present (a) keeps the base plugin loadable in every other IDE and
         (b) guarantees the Rider group is registered before we reference it. -->
    <depends optional="true" config-file="rider.xml">com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Audio Explainer" anchor="right"
                    icon="AllIcons.Toolwindows.Documentation"
                    factoryClass="com.audioexplainer.AudioExplainerToolWindowFactory"/>
        <postStartupActivity implementation="com.audioexplainer.ServerStartupActivity"/>
        <!-- The tree host, and now the only one (Phase 2). Accepts only TreePlanVirtualFile, so no file of
             the user's can reach it; HIDE_DEFAULT_EDITOR keeps the platform from offering a text tab beside it.
             The dev bench provider that used to sit here, and the fixture-plan menu beside it, came out with
             the com.audioexplainer.spike package before release. -->
        <fileEditorProvider implementation="com.audioexplainer.tree.TreePlanEditorProvider"/>
        <applicationService serviceImplementation="com.audioexplainer.ExplainerServerService"/>
        <applicationService serviceImplementation="com.audioexplainer.AudioExplainerSettings"/>
        <applicationService serviceImplementation="com.audioexplainer.ClaudeExplainer"/>
        <applicationService serviceImplementation="com.audioexplainer.TtsService"/>
        <applicationConfigurable parentId="tools"
                                 id="com.audioexplainer.settings"
                                 displayName="Audio Explainer"
                                 instance="com.audioexplainer.HighlightSettingsConfigurable"/>
        <notificationGroup id="Audio Explainer" displayType="BALLOON"/>
        <!-- Saving.md D: an unsaved walkthrough is asked about before the project closes. The vetoable hook,
             so Cancel keeps the project open. -->
        <projectCloseHandler implementation="com.audioexplainer.UnsavedWalkthroughCloseHandler"/>
    </extensions>

    <actions>
        <action id="AudioExplainer.ExplainThis"
                class="com.audioexplainer.ExplainThisAction"
                text="Explain This (Audio)"
                description="Audio-explain the selected code, the symbol under the cursor, or the selected file/folder">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Solution Explorer / Project view: explain a selected file, folder, or project node. -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <!-- The per-run overrides (Effort.md). Declared AFTER the plain entry and anchored "last" in the
             same two groups, so it lands directly under it: the common case stays one click and does not
             move, and the dialog is the thing you go looking for. -->
        <action id="AudioExplainer.ExplainThisWith"
                class="com.audioexplainer.ExplainThisWithAction"
                text="Explain This (Audio) with&#8230;"
                description="Audio-explain with a per-run effort, depth and extra instructions">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <group id="AudioExplainer.ToolsMenu" text="Audio Explainer" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="AudioExplainer.SetupTts"
                    class="com.audioexplainer.ConfigureTtsAction"
                    text="Audio engines…"
                    description="Open the per-engine narration settings: status, install Kokoro / language packs, Windows voices"/>
            <action id="AudioExplainer.ShowRunLog"
                    class="com.audioexplainer.ShowRunLogAction"
                    text="Show Run Log"
                    icon="AllIcons.Debugger.Console"
                    description="Every step of the latest Explain This run: reads, thinking, the plan sent and its reply, the host"/>
        </group>
    </actions>
</idea-plugin>
