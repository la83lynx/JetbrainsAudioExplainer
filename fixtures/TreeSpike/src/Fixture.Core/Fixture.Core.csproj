<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Deliberately off. With it on, 82 CS1591 warnings cover the fixture in squiggles and error-stripe
         marks, which is exactly the noise B5 has to see past when it classifies markers as colour vs.
         diagnostics. Phase 0 §6.2 got a clean 0-diagnostic reading; keep it that way. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
